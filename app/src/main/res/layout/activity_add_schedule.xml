<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_blue"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header back button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/btn_back_add_schedule"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Kembali"
            android:focusable="true"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

    </RelativeLayout>

    <!-- Main Container Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Dynamic Form Title (TAMBAH JADWAL / EDIT JADWAL) -->
            <TextView
                android:id="@+id/tv_form_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="TAMBAH JADWAL"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 1. Judul / Jenis Jadwal -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Judul / Jenis Jadwal"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/sp_sch_title"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingHorizontal="12dp" />

                    <!-- Judul Kustom (jika memilih opsi kustom) -->
                    <EditText
                        android:id="@+id/et_sch_title_custom"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="Tuliskan judul kustom..."
                        android:paddingHorizontal="12dp"
                        android:textColor="#000000"
                        android:textColorHint="#777777"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <!-- 2. Row Tanggal & Waktu -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:orientation="horizontal">

                        <!-- Tanggal -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="Tanggal"
                                android:textColor="@color/black"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/et_sch_date"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_input_field"
                                android:clickable="true"
                                android:drawableStart="@drawable/ic_calendar"
                                android:drawablePadding="8dp"
                                android:focusable="false"
                                android:hint="dd MMM yyyy"
                                android:paddingHorizontal="12dp"
                                android:textColor="#000000"
                                android:textColorHint="#777777"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Waktu -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="Waktu"
                                android:textColor="@color/black"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/et_sch_time"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_input_field"
                                android:clickable="true"
                                android:drawableStart="@drawable/ic_clock"
                                android:drawablePadding="8dp"
                                android:focusable="false"
                                android:hint="08.00 WIB"
                                android:paddingHorizontal="12dp"
                                android:textColor="#000000"
                                android:textColorHint="#777777"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 3. Lokasi Posyandu -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Lokasi Posyandu"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/sp_sch_location"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingHorizontal="12dp" />

                    <!-- 4. Status Kegiatan -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Status Kegiatan"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/sp_sch_status"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingHorizontal="12dp" />

                    <!-- 5. Pesan Notifikasi -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Pesan Notifikasi"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_sch_pesan"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_marginBottom="20dp"
                        android:background="@drawable/bg_input_field"
                        android:gravity="top|start"
                        android:hint="Tuliskan isi pesan notifikasi pengingat..."
                        android:inputType="textMultiLine"
                        android:padding="12dp"
                        android:textColor="#000000"
                        android:textColorHint="#777777"
                        android:textSize="14sp" />

                </LinearLayout>
            </ScrollView>

            <!-- Save Button -->
            <android.widget.Button
                android:id="@+id/btn_sch_save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn_blue"
                android:text="KIRIM NOTIFIKASI &amp; SIMPAN"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
