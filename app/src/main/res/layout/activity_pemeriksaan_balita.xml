<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header back button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/btn_back_pemeriksaan_balita"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

    </RelativeLayout>

    <!-- Main Container Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="PEMERIKSAAN BALITA"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Scrollable form contents -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Nama Balita (Read-only Edittext) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Nama Balita"
                        android:textColor="@color/black"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_exam_child_name"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_input_blue"
                        android:enabled="false"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/white"
                        android:textColorHint="#DDDDDD"
                        android:textSize="15sp" />

                    <!-- Tanggal Pemeriksaan -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Tanggal Pemeriksaan"
                        android:textColor="@color/black"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_exam_date"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_input_blue"
                        android:clickable="true"
                        android:focusable="false"
                        android:hint="Pilih tanggal..."
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/white"
                        android:textColorHint="#DDDDDD"
                        android:textSize="15sp" />

                    <!-- Berat Anak (Kg) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Berat Anak (Kg)"
                        android:textColor="@color/black"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_exam_weight"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_input_blue"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="16dp"
                        android:singleLine="true"
                        android:textColor="@color/white"
                        android:textColorHint="#DDDDDD"
                        android:textSize="15sp" />

                    <!-- Tinggi Anak (Cm) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Tinggi Anak (Cm)"
                        android:textColor="@color/black"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_exam_height"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_input_blue"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="16dp"
                        android:singleLine="true"
                        android:textColor="@color/white"
                        android:textColorHint="#DDDDDD"
                        android:textSize="15sp" />

                    <!-- Status Balita -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Status Balita"
                        android:textColor="@color/black"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_exam_status"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="24dp"
                        android:background="@drawable/bg_input_blue"
                        android:clickable="false"
                        android:enabled="false"
                        android:focusable="false"
                        android:hint="Otomatis terhitung..."
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/white"
                        android:textColorHint="#DDDDDD"
                        android:textSize="15sp" />

                </LinearLayout>

            </ScrollView>

            <!-- Save Button -->
            <android.widget.Button
                android:id="@+id/btn_exam_save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn_blue"
                android:text="SIMPAN"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
