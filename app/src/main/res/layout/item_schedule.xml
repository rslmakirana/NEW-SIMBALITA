<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/iv_sch_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="#E0F2FE"
            android:padding="10dp"
            android:src="@drawable/ic_calendar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#0284C7" />

        <TextView
            android:id="@+id/tv_sch_datetime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="15 Juli 2026 - 08.00 WIB"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/iv_sch_edit"
            app:layout_constraintStart_toEndOf="@id/iv_sch_icon"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_sch_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:text="Posyandu Melati 1"
            android:textColor="#000000"
            android:textSize="13.5sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/iv_sch_edit"
            app:layout_constraintStart_toEndOf="@id/iv_sch_icon"
            app:layout_constraintTop_toBottomOf="@id/tv_sch_datetime" />

        <TextView
            android:id="@+id/tv_sch_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="2dp"
            android:text="Jl. Melati No. 10"
            android:textColor="#000000"
            android:textSize="12.5sp"
            app:layout_constraintEnd_toStartOf="@+id/iv_sch_edit"
            app:layout_constraintStart_toEndOf="@id/iv_sch_icon"
            app:layout_constraintTop_toBottomOf="@id/tv_sch_title" />

        <TextView
            android:id="@+id/tv_sch_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:text="Status: Belum Terlaksana"
            android:textColor="#2E6B34"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/iv_sch_edit"
            app:layout_constraintStart_toEndOf="@id/iv_sch_icon"
            app:layout_constraintTop_toBottomOf="@id/tv_sch_location" />

        <ImageView
            android:id="@+id/iv_sch_edit"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="2dp"
            android:src="@drawable/ic_edit"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_sch_delete"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#2E6B34" />

        <ImageView
            android:id="@+id/iv_sch_delete"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="2dp"
            android:src="@drawable/ic_delete"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#EC837E" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
